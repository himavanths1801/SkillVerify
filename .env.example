# Copy this file to .env and fill in your own values. Never commit .env.

# GitHub personal access token (reads public repositories). https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
# Optional second token, used as a backup when the first hits its rate limit
GITHUB_TOKEN_BACKUP=your_backup_github_token_here

# Google Gemini API key. https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: comma-separated Gemini model names, tried in order when one is rate limited
GEMINI_MODEL_CHAIN=model-name-one,model-name-two

# Groq API key (optional). When set, Groq is the first model for writing interview questions, and Gemini is the fallback.
# https://console.groq.com/keys   Leave empty to use Gemini only.
GROQ_API_KEY=
# Optional: comma-separated models for the question writer, tried in order. A plain name is a Gemini model; a
# groq: prefix is a Groq model, e.g. groq:openai/gpt-oss-120b,gemini-model-name. Leave empty for the default
# (Groq first, then the Gemini chain above).
QUESTIONS_MODEL_CHAIN=

# Question writer pacing and saved results (all optional; the defaults are shown)
# Minimum seconds between two calls to the SAME model (0 to 30)
QUESTIONS_MIN_GAP_SECONDS=3
# When every model is resting, wait at most this many seconds for the first one to be ready (0 to 120)
QUESTIONS_MAX_WAIT_SECONDS=25
# Where finished analyses, question runs and fetched file texts are saved (default: api/_data/). Never commit it.
SKILLVERIFY_DATA_DIR=
# Saved analyses and question runs older than this many days are deleted when the server starts (1 to 90)
SAVED_RESULTS_DAYS=14

# Reading the CV and the job description (all optional; the defaults are shown)
# Models that read them, tried in order; same format as QUESTIONS_MODEL_CHAIN. Leave empty for the Gemini chain above.
# Groq reads only if you add a groq: entry here; compare it with Gemini on real documents first.
READING_MODEL_CHAIN=
# Minimum seconds between two calls to the SAME model (0 to 30)
READING_MIN_GAP_SECONDS=2
# When every reading model is resting, wait at most this many seconds for the first one to be ready (0 to 60)
READING_MAX_WAIT_SECONDS=20

# Question writer: the most tokens Groq may answer with (500 to 8000). Leave empty to send no cap (Groq's own default),
# which is what has always been sent. Raise it only if drops show the cause "cut_off" (see docs/QUESTIONS.md).
QUESTIONS_MAX_OUTPUT_TOKENS=
