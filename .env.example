# Copy this file to .env and fill in your own values. Never commit .env.

# GitHub personal access token (reads public repositories). https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
# Optional second token, used as a backup when the first hits its rate limit
GITHUB_TOKEN_BACKUP=your_backup_github_token_here

# Google Gemini API key. https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: comma-separated Gemini model names, tried in order when one is rate limited
GEMINI_MODEL_CHAIN=model-name-one,model-name-two
